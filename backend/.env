# ─── Database ────────────────────────────────────────────────────────────────
# Default: SQLite (Zero setup needed, works out of the box)
DATABASE_URL=sqlite:///./smart_city.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./smart_city.db

# For PostgreSQL (Uncomment below when PostgreSQL is running):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_city_db
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_city_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
SECRET_KEY=smart-city-super-secret-key-32-chars-long-example
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin Defaults ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@smartcity.com
ADMIN_PASSWORD=Admin@123!
ADMIN_USERNAME=admin

# ─── External APIs ────────────────────────────────────────────────────────────
OPENAQ_API_URL=https://api.openaq.org/v2
WAQI_API_TOKEN=demo
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5
WORLD_BANK_API_URL=https://api.worldbank.org/v2

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=Smart City Intelligence Platform
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
DATA_COLLECT_INTERVAL_HOURS=6
