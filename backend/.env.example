# Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smart_city_db
# For async support:
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/smart_city_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin Defaults ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@smartcity.com
ADMIN_PASSWORD=Admin@123!
ADMIN_USERNAME=admin

# ─── External APIs (all free tiers) ─────────────────────────────────────────
# OpenAQ (no key required for v2 public endpoints)
OPENAQ_API_URL=https://api.openaq.org/v2

# WAQI (World Air Quality Index) - free token at https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=demo

# Open-Meteo (no key required - completely free)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# OpenWeatherMap - free at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5

# World Bank API (no key required)
WORLD_BANK_API_URL=https://api.worldbank.org/v2

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=Smart City Intelligence Platform
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Data Collection Schedule (cron format) ──────────────────────────────────
DATA_COLLECT_INTERVAL_HOURS=6
